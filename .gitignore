# Virtual environment (anchored to repo root so it doesn't also match src/echoledger/,
# since git on Windows is case-insensitive by default)
/EchoLedger/
.venv/
venv/

# Build artifact from `pip install -e`
*.egg-info/

# Secrets
.env

# Downloaded/cached data (large, re-fetchable, never committed)
data/

# SQLite database
*.db
*.sqlite3

# Python
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
