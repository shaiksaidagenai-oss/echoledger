# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Timezone used for "today" when computing dates (default if unset: Asia/Kolkata)
ECHOLEDGER_TIMEZONE=Asia/Kolkata

# Required from Phase 2 onward. Get one at console.anthropic.com -> Settings -> API Keys.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which Claude model to use (configurable per the project's cost-control rule).
ECHOLEDGER_LLM_MODEL=claude-haiku-4-5

# Required from Phase 3 onward (embeddings). Get one at platform.openai.com -> API keys.
OPENAI_API_KEY=sk-your-key-here

# Deployed only (Phase 6) - leave unset for local dev. When set, config.py fetches
# ANTHROPIC_API_KEY/OPENAI_API_KEY from this AWS Secrets Manager secret instead of
# the values above. The deployed container's IAM role must have secretsmanager:GetSecretValue.
# ECHOLEDGER_SECRETS_ARN=arn:aws:secretsmanager:ap-southeast-2:529470780389:secret:echoledger/api-keys-G06R0H
