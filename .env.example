# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Timezone used for "today" when computing dates (default if unset: Asia/Kolkata)
ECHOLEDGER_TIMEZONE=Asia/Kolkata

# Required from Phase 2 onward. Get one at console.anthropic.com -> Settings -> API Keys.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which Claude model to use (configurable per the project's cost-control rule).
ECHOLEDGER_LLM_MODEL=claude-haiku-4-5

# Required from Phase 3 onward (embeddings). Get one at platform.openai.com -> API keys.
OPENAI_API_KEY=sk-your-key-here

# Deployed only (Phase 6) - leave unset for local dev. When set, config.py fetches
# ANTHROPIC_API_KEY/OPENAI_API_KEY from this AWS Secrets Manager secret instead of
# the values above. The deployed container's IAM role must have secretsmanager:GetSecretValue.
# ECHOLEDGER_SECRETS_ARN=arn:aws:secretsmanager:ap-southeast-2:529470780389:secret:echoledger/api-keys-G06R0H

# Required only for `echoledger fetch --approval email` (Step 2, Session C). Same signing
# key the approval-handler service verifies against - fetched from the secret above when
# deployed; set locally too if testing the email path from this machine.
# APPROVAL_SIGNING_KEY=
# Where the approval-handler service is currently reachable (its public IP changes on every
# ECS task restart - see CLAUDE.md's "Live resource reference" for the current one).
# ECHOLEDGER_APPROVAL_BASE_URL=http://<approval-handler-ip>:8080
# The email address that receives the daily approval email and SES sends from (SES sandbox
# mode only allows sending to/from verified addresses - see PROGRESS.md Session 10).
# ECHOLEDGER_NOTIFY_EMAIL=
