# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Timezone used for "today" when computing dates (default if unset: Asia/Kolkata)
ECHOLEDGER_TIMEZONE=Asia/Kolkata

# Required from Phase 2 onward. Get one at console.anthropic.com -> Settings -> API Keys.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which Claude model to use (configurable per the project's cost-control rule).
ECHOLEDGER_LLM_MODEL=claude-haiku-4-5
